{
  "name": "cs2-esports-tracker",
  "version": "1.0.0",
  "description": "Desktop application for tracking CS2 esports matches and betting opportunities",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "cs2",
    "esports",
    "tracker",
    "betting",
    "desktop"
  ],
  "author": "Farside77",
  "license": "MIT",
  "build": {
    "appId": "com.farside77.cs2tracker",
    "productName": "CS2 Esports Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "backend/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      "backend/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/favicon.ico",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/favicon.ico",
      "category": "Game"
    }
  }
}
